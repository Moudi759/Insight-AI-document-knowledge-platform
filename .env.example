# ──────────────────────────────────────────────────────────────
# Insight — Environment Configuration
# Copy this file to .env.local and fill in the values.
# ──────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
# Local example: postgresql://postgres:postgres@localhost:5432/insight
DATABASE_URL=

# Auth.js secret used to sign/encrypt session tokens (required)
# Generate one: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=same-as-AUTH_SECRET
NEXTAUTH_URL=http://localhost:3000

# ── AI provider (optional) ────────────────────────────────────
# Any OpenAI-compatible API works. When AI_API_KEY is empty,
# Insight automatically runs in demo mode with a local
# retrieval engine so the whole app stays functional.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# ── File storage (optional) ───────────────────────────────────
# Local development stores uploads under .storage/. Point
# STORAGE_DRIVER=s3 and provide S3_* values for production.
STORAGE_DRIVER=local

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
