# ──────────────────────────────────────────────────────────────
# Insight — Environment Configuration
# Copy this file to .env.local and fill in the values.
# ──────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
# Local example: postgresql://postgres:postgres@localhost:5432/insight
DATABASE_URL=

# Auth.js secret used to sign/encrypt session tokens (required)
# Generate one: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=same-as-AUTH_SECRET
NEXTAUTH_URL=http://localhost:3000

# ── AI provider (optional) ────────────────────────────────────
# Any OpenAI-compatible API works. When AI_API_KEY is empty,
# Insight automatically runs in demo mode with a local
# retrieval engine so the whole app stays functional.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# ── File storage ──────────────────────────────────────────────
# "local" writes under .storage/ (development).
# On Vercel the driver auto-switches to "database" (BYTEA in Postgres)
# because serverless filesystems are read-only. Override if needed:
STORAGE_DRIVER=local

# Upload cap in MB. Serverless hosts reject bodies over ~4.5 MB, so
# Vercel deployments are automatically capped at 4 unless set higher.
MAX_FILE_SIZE_MB=20

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Plan limits (optional, free plan defaults shown) ─────────
PLAN_DOCUMENT_LIMIT=50
PLAN_MONTHLY_QUESTIONS=200
